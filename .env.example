TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BOT_INVITE_CODE=
BOT_OPEN_REGISTRATION=false
MAX_SUBSCRIBERS=50
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=
DATABASE_URL=
POSTGRES_PASSWORD=stock_agent_local
DOCKER_PROXY_URL=http://host.docker.internal:6152

# 可选：网络代理与新闻聚合源
HTTP_PROXY=
HTTPS_PROXY=
NEWSNOW_BASE_URL=https://newsnow.busiyi.world
# 纯IPv6网络（无公网IPv4的云主机）设为true：行情改走有IPv6的接口入口，跳过同花顺
IPV6_ONLY=false

# 可选：盘中资金异动提醒。时间段“名称@HH:MM-HH:MM”，多个用逗号分隔，如 尾盘@14:30-15:00,开盘@09:30-10:00
FUND_FLOW_WINDOWS=尾盘@14:30-15:00
FUND_FLOW_POLL_MINUTES=1
# 区间主力净额变化同时达到金额（万元）与占当日成交额比例（%）才推送
FUND_FLOW_MIN_AMOUNT_WAN=5000
FUND_FLOW_MIN_RATIO_PCT=2

# 可选：调试日志
DEBUG=0
