TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BOT_INVITE_CODE=
BOT_OPEN_REGISTRATION=false
MAX_SUBSCRIBERS=50
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=
DATABASE_URL=
POSTGRES_PASSWORD=stock_agent_local
DOCKER_PROXY_URL=http://host.docker.internal:6152

# 可选：网络代理与新闻聚合源
HTTP_PROXY=
HTTPS_PROXY=
NEWSNOW_BASE_URL=https://newsnow.busiyi.world
# 纯IPv6网络（无公网IPv4的云主机）设为true：行情改走有IPv6的接口入口，跳过同花顺
IPV6_ONLY=false

# 可选：盘中资金异动提醒。时间段“名称@HH:MM-HH:MM”，多个用逗号分隔，如 尾盘@14:30-15:00,开盘@09:30-10:00
FUND_FLOW_WINDOWS=尾盘@14:30-15:00
FUND_FLOW_POLL_MINUTES=1
# 区间主力净额变化同时达到金额（万元）与占当日成交额比例（%）才推送
FUND_FLOW_MIN_AMOUNT_WAN=5000
FUND_FLOW_MIN_RATIO_PCT=2

# 可选：盘中量价异动提醒（沪市上交所行情、深市新浪行情）。时间段格式同上
VOLUME_SPIKE_WINDOWS=上午@09:30-11:30,下午@13:00-14:57
# 回看几分钟；这段时间的成交额（万元）与涨跌幅变化（个百分点）同时达到才推送
VOLUME_SPIKE_LOOKBACK_MINUTES=5
VOLUME_SPIKE_MIN_AMOUNT_WAN=5000
VOLUME_SPIKE_MIN_CHANGE_PCT=2
# 每几分钟汇总推送一次（时间段结束时也推一次）
VOLUME_SPIKE_PUSH_MINUTES=10

# 可选：每日总结网页（收盘报告、盘中异动回顾、龙虎榜与游资动向汇总到一个网页，每天只推两条消息）。
# 托管在 GCS 存储桶（需公开可读，建议设7天自动删除；GCP 虚拟机需 devstorage.read_write 权限范围），
# 页面地址里的令牌由 DAILY_PAGE_SECRET 生成（随机长字符串，改了以后旧链接失效）。不配置时仍逐条推送图片
DAILY_PAGE_BUCKET=
DAILY_PAGE_SECRET=

# 可选：调试日志
DEBUG=0
